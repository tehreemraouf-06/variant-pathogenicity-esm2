      "cell_type": "code",
      "source": [
        "import pandas as pd, numpy as np\n",
        "from sklearn.model_selection import GroupKFold, StratifiedKFold\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import roc_auc_score, average_precision_score, matthews_corrcoef\n",
        "import lightgbm as lgb\n",
        "\n",
        "base = \"/content/drive/MyDrive/variant_project/data/\"\n",
        "df = pd.read_csv(base + \"features_labeled.csv\")\n",
        "y, groups = df[\"label\"].values, df[\"GeneSymbol\"].values\n",
        "\n",
        "simple = [\"blosum\", \"d_hydro\", \"d_vol\", \"d_charge\", \"rel_pos\"]\n",
        "allf = simple + [\"esm_score\", \"esm_wt_logp\"]\n",
        "\n",
        "def make_lr(): return make_pipeline(StandardScaler(), LogisticRegression(max_iter=1000))\n",
        "def make_lgb(): return lgb.LGBMClassifier(n_estimators=200, learning_rate=0.05, random_state=42, verbose=-1)\n",
        "\n",
        "experiments = {\n",
        "    \"ESM score only (no training)\": (None, [\"esm_score\"]),\n",
        "    \"Simple features + LogReg\": (make_lr, simple),\n",
        "    \"Simple features + LightGBM\": (make_lgb, simple),\n",
        "    \"ESM + simple + LightGBM\": (make_lgb, allf),\n",
        "}\n",
        "\n",
        "splits = {\n",
        "    \"Random split\": StratifiedKFold(5, shuffle=True, random_state=42).split(df, y),\n",
        "    \"Gene-held-out split\": GroupKFold(5).split(df, y, groups),\n",
        "}\n",
        "split_list = {k: list(v) for k, v in splits.items()}\n",
        "\n",
        "rows = []\n",
        "for sname, folds in split_list.items():\n",
        "    for mname, (maker, feats) in experiments.items():\n",
        "        X = df[feats].values\n",
        "        auc, ap, mcc = [], [], []\n",
        "        for tr, te in folds:\n",
        "            if maker is None:\n",
        "                p = -X[te, 0]\n",
        "                thr = np.median(-X[tr, 0])\n",
        "            else:\n",
        "                m = maker().fit(X[tr], y[tr])\n",
        "                p = m.predict_proba(X[te])[:, 1]\n",
        "                thr = 0.5\n",
        "            auc.append(roc_auc_score(y[te], p))\n",
        "            ap.append(average_precision_score(y[te], p))\n",
        "            mcc.append(matthews_corrcoef(y[te], (p > thr).astype(int)))\n",
        "        rows.append([sname, mname, np.mean(auc), np.std(auc), np.mean(ap), np.mean(mcc)])\n",
        "\n",
        "res = pd.DataFrame(rows, columns=[\"Split\", \"Model\", \"AUROC\", \"AUROC_std\", \"AUPRC\", \"MCC\"]).round(3)\n",
        "res.to_csv(base + \"results_table.csv\", index=False)\n",
        "res"
      ],
