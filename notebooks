      "source": [
        "import pandas as pd, re\n",
        "\n",
        "df = pd.read_csv(\"/content/drive/MyDrive/variant_project/data/clinvar_filtered.csv\")\n",
        "print(\"Start:\", df.shape[0])\n",
        "\n",
        "# 1. Extract the protein change, e.g. (p.Gly1046Arg)\n",
        "pat = r\"\\(p\\.([A-Z][a-z]{2})(\\d+)([A-Z][a-z]{2})\\)\"\n",
        "m = df[\"Name\"].str.extract(pat)\n",
        "df[\"wt3\"], df[\"pos\"], df[\"mut3\"] = m[0], m[1], m[2]\n",
        "df = df.dropna(subset=[\"pos\"]).copy()\n",
        "df[\"pos\"] = df[\"pos\"].astype(int)\n",
        "\n",
        "# 2. Keep only the 20 standard amino acids (this removes stop codons \"Ter\")\n",
        "aa = {\"Ala\":\"A\",\"Arg\":\"R\",\"Asn\":\"N\",\"Asp\":\"D\",\"Cys\":\"C\",\"Gln\":\"Q\",\"Glu\":\"E\",\n",
        "      \"Gly\":\"G\",\"His\":\"H\",\"Ile\":\"I\",\"Leu\":\"L\",\"Lys\":\"K\",\"Met\":\"M\",\"Phe\":\"F\",\n",
        "      \"Pro\":\"P\",\"Ser\":\"S\",\"Thr\":\"T\",\"Trp\":\"W\",\"Tyr\":\"Y\",\"Val\":\"V\"}\n",
        "df = df[df[\"wt3\"].isin(aa) & df[\"mut3\"].isin(aa)].copy()\n",
        "df[\"wt\"] = df[\"wt3\"].map(aa)\n",
        "df[\"mut\"] = df[\"mut3\"].map(aa)\n",
        "df = df[df[\"wt\"] != df[\"mut\"]]\n",
        "print(\"After keeping missense only:\", df.shape[0])\n",
        "\n",
        "# 3. Keep only variants with a quality review (criteria provided)\n",
        "df = df[df[\"ReviewStatus\"].str.startswith((\"criteria provided\", \"reviewed by expert\", \"practice guideline\"), na=False)]\n",
        "print(\"After quality filter:\", df.shape[0])\n",
        "\n",
        "# 4. Make labels\n",
        "pathogenic = [\"Pathogenic\", \"Likely pathogenic\", \"Pathogenic/Likely pathogenic\"]\n",
        "benign = [\"Benign\", \"Likely benign\", \"Benign/Likely benign\"]\n",
        "vus = [\"Uncertain significance\"]\n",
        "\n",
        "def make_label(x):\n",
        "    if x in pathogenic: return 1\n",
        "    if x in benign: return 0\n",
        "    if x in vus: return -1\n",
        "    return None\n",
        "\n",
        "df[\"label\"] = df[\"ClinicalSignificance\"].map(make_label)\n",
        "df = df.dropna(subset=[\"label\"]).copy()\n",
        "df[\"label\"] = df[\"label\"].astype(int)\n",
        "\n",
        "# 5. Remove duplicates\n",
        "df = df.drop_duplicates(subset=[\"GeneSymbol\", \"pos\", \"wt\", \"mut\", \"label\"])\n",
        "print(\"After removing duplicates:\", df.shape[0])\n",
        "print(df[\"label\"].value_counts())\n",
        "\n",
        "df.to_csv(\"/content/drive/MyDrive/variant_project/data/clinvar_missense.csv\", index=False)\n",
        "print(\"Saved!\")"
