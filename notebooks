        "import os, json, time\n",
        "import pandas as pd, numpy as np\n",
        "import torch\n",
        "\n",
        "base = \"/content/drive/MyDrive/variant_project/data/\"\n",
        "out_file = base + \"esm_position_scores.csv\"\n",
        "sequences = json.load(open(base + \"sequences.json\"))\n",
        "\n",
        "letters = list(\"ACDEFGHIKLMNPQRSTVWY\")\n",
        "letter_ids = {a: tok.convert_tokens_to_ids(a) for a in letters}\n",
        "\n",
        "def position_logp(seq, pos, window=1000):\n",
        "    if len(seq) > window:\n",
        "        start = max(0, min(pos - 1 - window // 2, len(seq) - window))\n",
        "        seq = seq[start:start + window]\n",
        "        pos = pos - start\n",
        "    enc = tok(seq, return_tensors=\"pt\").to(device)\n",
        "    ids = enc[\"input_ids\"].clone()\n",
        "    ids[0, pos] = tok.mask_token_id\n",
        "    with torch.no_grad():\n",
        "        logits = model(input_ids=ids, attention_mask=enc[\"attention_mask\"]).logits\n",
        "    logp = torch.log_softmax(logits[0, pos], dim=-1)\n",
        "    return [logp[letter_ids[a]].item() for a in letters]\n",
        "\n",
        "# All unique (gene, position) pairs, labeled ones first\n",
        "lab = pd.read_csv(base + \"labeled_clean.csv\")\n",
        "vus = pd.read_csv(base + \"vus_clean.csv\")\n",
        "positions = (pd.concat([lab, vus])[[\"GeneSymbol\", \"pos\"]]\n",
        "             .drop_duplicates().reset_index(drop=True))\n",
        "\n",
        "# Skip positions already done (this makes the cell resumable)\n",
        "done = set()\n",
        "if os.path.exists(out_file):\n",
        "    d = pd.read_csv(out_file, usecols=[\"GeneSymbol\", \"pos\"])\n",
        "    done = set(zip(d[\"GeneSymbol\"], d[\"pos\"]))\n",
        "\n",
        "todo = [(g, p) for g, p in zip(positions[\"GeneSymbol\"], positions[\"pos\"]) if (g, p) not in done]\n",
        "print(\"Unique positions total:\", len(positions))\n",
        "print(\"Already done:\", len(done))\n",
        "print(\"Left to do:\", len(todo))\n",
        "print(\"Rough time left (minutes):\", round(len(todo) * 0.2 / 60, 1))\n",
        "\n",
        "buffer = []\n",
        "t0 = time.time()\n",
        "for i, (g, p) in enumerate(todo):\n",
        "    row = [g, p] + position_logp(sequences[g], p)\n",
        "    buffer.append(row)\n",
        "    if len(buffer) >= 500 or i == len(todo) - 1:\n",
        "        pd.DataFrame(buffer, columns=[\"GeneSymbol\", \"pos\"] + letters).to_csv(\n",
        "            out_file, mode=\"a\", header=not os.path.exists(out_file), index=False)\n",
        "        buffer = []\n",
        "        print(f\"{i+1}/{len(todo)} saved, {(time.time()-t0)/60:.1f} min elapsed\")\n",
        "\n",
        "print(\"Finished!\")"
