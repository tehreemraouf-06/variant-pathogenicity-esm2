        "import warnings; warnings.filterwarnings(\"ignore\")\n",
        "import pandas as pd, numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.model_selection import GroupKFold\n",
        "from sklearn.metrics import roc_curve, roc_auc_score\n",
        "from sklearn.calibration import calibration_curve\n",
        "import lightgbm as lgb\n",
        "\n",
        "base = \"/content/drive/MyDrive/variant_project/data/\"\n",
        "df = pd.read_csv(base + \"features_labeled.csv\")\n",
        "y, groups = df[\"label\"].values, df[\"GeneSymbol\"].values\n",
        "\n",
        "simple = [\"blosum\", \"d_hydro\", \"d_vol\", \"d_charge\", \"rel_pos\"]\n",
        "allf = simple + [\"esm_score\", \"esm_wt_logp\"]\n",
        "\n",
        "# Out-of-fold predictions with the gene-held-out split\n",
        "oof_all = np.zeros(len(df)); oof_simple = np.zeros(len(df))\n",
        "for tr, te in GroupKFold(5).split(df, y, groups):\n",
        "    for feats, store in [(allf, oof_all), (simple, oof_simple)]:\n",
        "        m = lgb.LGBMClassifier(n_estimators=200, learning_rate=0.05, random_state=42, verbose=-1)\n",
        "        m.fit(df.iloc[tr][feats], y[tr])\n",
        "        store[te] = m.predict_proba(df.iloc[te][feats])[:, 1]\n",
        "oof_esm = -df[\"esm_score\"].values\n",
        "\n",
        "# ROC curves\n",
        "plt.figure(figsize=(6, 5))\n",
        "for name, p in [(\"ESM + simple + LightGBM\", oof_all), (\"Simple + LightGBM\", oof_simple), (\"ESM score only\", oof_esm)]:\n",
        "    fpr, tpr, _ = roc_curve(y, p)\n",
        "    plt.plot(fpr, tpr, label=f\"{name} (AUROC {roc_auc_score(y, p):.3f})\")\n",
        "plt.plot([0, 1], [0, 1], \"k--\", alpha=0.4)\n",
        "plt.xlabel(\"False positive rate\"); plt.ylabel(\"True positive rate\")\n",
        "plt.title(\"ROC curves (gene-held-out)\"); plt.legend(loc=\"lower right\")\n",
        "plt.savefig(base + \"fig_roc.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
        "\n",
        "# Calibration curve\n",
        "frac, mean_pred = calibration_curve(y, oof_all, n_bins=10)\n",
        "plt.figure(figsize=(5, 5))\n",
        "plt.plot(mean_pred, frac, \"o-\", label=\"Model\")\n",
        "plt.plot([0, 1], [0, 1], \"k--\", label=\"Perfect\")\n",
        "plt.xlabel(\"Predicted probability\"); plt.ylabel(\"Fraction truly pathogenic\")\n",
        "plt.title(\"Calibration (gene-held-out)\"); plt.legend()\n",
        "plt.savefig(base + \"fig_calibration.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
        "\n",
        "# AUROC per gene (which genes are hard?)\n",
        "rows = []\n",
        "for g in df[\"GeneSymbol\"].unique():\n",
        "    mask = groups == g\n",
        "    if len(set(y[mask])) == 2:\n",
        "        rows.append([g, mask.sum(), roc_auc_score(y[mask], oof_all[mask])])\n",
        "per_gene = pd.DataFrame(rows, columns=[\"gene\", \"n_variants\", \"auroc\"]).sort_values(\"auroc\")\n",
        "per_gene.to_csv(base + \"per_gene_auroc.csv\", index=False)\n",
        "print(\"Hardest 8 genes:\"); print(per_gene.head(8).round(3).to_string(index=False))\n",
        "print(\"\\nEasiest 5 genes:\"); print(per_gene.tail(5).round(3).to_string(index=False))"
