        "import pandas as pd, numpy as np, json\n",
        "from Bio.Align import substitution_matrices\n",
        "\n",
        "base = \"/content/drive/MyDrive/variant_project/data/\"\n",
        "letters = list(\"ACDEFGHIKLMNPQRSTVWY\")\n",
        "li = {a: i for i, a in enumerate(letters)}\n",
        "\n",
        "scores = pd.read_csv(base + \"esm_position_scores.csv\").drop_duplicates(subset=[\"GeneSymbol\", \"pos\"])\n",
        "sequences = json.load(open(base + \"sequences.json\"))\n",
        "lab = pd.read_csv(base + \"labeled_clean.csv\")\n",
        "vus = pd.read_csv(base + \"vus_clean.csv\")\n",
        "\n",
        "B = substitution_matrices.load(\"BLOSUM62\")\n",
        "kd = dict(A=1.8,R=-4.5,N=-3.5,D=-3.5,C=2.5,Q=-3.5,E=-3.5,G=-0.4,H=-3.2,I=4.5,\n",
        "          L=3.8,K=-3.9,M=1.9,F=2.8,P=-1.6,S=-0.8,T=-0.7,W=-0.9,Y=-1.3,V=4.2)\n",
        "vol = dict(A=88.6,R=173.4,N=114.1,D=111.1,C=108.5,Q=143.8,E=138.4,G=60.1,H=153.2,I=166.7,\n",
        "           L=166.7,K=168.6,M=162.9,F=189.9,P=112.7,S=89.0,T=116.1,W=227.8,Y=193.6,V=140.0)\n",
        "chg = {a: 0.0 for a in letters}\n",
        "chg.update(K=1, R=1, H=0.1, D=-1, E=-1)\n",
        "\n",
        "def build(df):\n",
        "    df = df.merge(scores, on=[\"GeneSymbol\", \"pos\"], how=\"left\").dropna(subset=letters).reset_index(drop=True)\n",
        "    arr = df[letters].values\n",
        "    n = np.arange(len(df))\n",
        "    wt_i = df[\"wt\"].map(li).values\n",
        "    mut_i = df[\"mut\"].map(li).values\n",
        "    df[\"esm_score\"] = arr[n, mut_i] - arr[n, wt_i]\n",
        "    df[\"esm_wt_logp\"] = arr[n, wt_i]\n",
        "    df[\"blosum\"] = [B[w][m] for w, m in zip(df[\"wt\"], df[\"mut\"])]\n",
        "    df[\"d_hydro\"] = df[\"mut\"].map(kd) - df[\"wt\"].map(kd)\n",
        "    df[\"d_vol\"] = df[\"mut\"].map(vol) - df[\"wt\"].map(vol)\n",
        "    df[\"d_charge\"] = df[\"mut\"].map(chg) - df[\"wt\"].map(chg)\n",
        "    df[\"rel_pos\"] = df[\"pos\"] / df[\"GeneSymbol\"].map(lambda g: len(sequences[g]))\n",
        "    return df.drop(columns=letters)\n",
        "\n",
        "lab_f = build(lab)\n",
        "vus_f = build(vus)\n",
        "print(\"Labeled:\", lab_f.shape, \" VUS:\", vus_f.shape)\n",
        "\n",
        "lab_f.to_csv(base + \"features_labeled.csv\", index=False)\n",
        "vus_f.to_csv(base + \"features_vus.csv\", index=False)\n",
        "lab_f[[\"GeneSymbol\", \"pos\", \"wt\", \"mut\", \"label\", \"esm_score\", \"blosum\"]].head()"
