    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "path = \"/content/drive/MyDrive/variant_project/data/variant_summary.txt.gz\"\n",
        "\n",
        "cols = [\"Type\", \"Name\", \"GeneSymbol\", \"ClinicalSignificance\",\n",
        "        \"ReviewStatus\", \"Assembly\", \"VariationID\"]\n",
        "\n",
        "keep = []\n",
        "total = 0\n",
        "\n",
        "for chunk in pd.read_csv(path, sep=\"\\t\", usecols=cols,\n",
        "                         chunksize=100_000, low_memory=False):\n",
        "    total += len(chunk)\n",
        "    chunk = chunk[\n",
        "        (chunk[\"Assembly\"] == \"GRCh38\") &\n",
        "        (chunk[\"Type\"] == \"single nucleotide variant\") &\n",
        "        (chunk[\"Name\"].str.contains(r\"\\(p\\.\", na=False))\n",
        "    ]\n",
        "    keep.append(chunk)\n",
        "\n",
        "df = pd.concat(keep, ignore_index=True)\n",
        "print(\"Total rows read:\", total)\n",
        "print(\"Rows kept:\", df.shape)\n",
        "\n",
        "df.to_csv(\"/content/drive/MyDrive/variant_project/data/clinvar_filtered.csv\", index=False)\n",
        "print(\"Saved!\")"
      ],
