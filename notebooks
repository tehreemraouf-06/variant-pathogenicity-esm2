        "vus_df = pd.read_csv(base + \"vus_variants.csv\")\n",
        "\n",
        "def check(row):\n",
        "    s = sequences.get(row[\"GeneSymbol\"])\n",
        "    if s is None or row[\"pos\"] > len(s):\n",
        "        return False\n",
        "    return s[row[\"pos\"] - 1] == row[\"wt\"]\n",
        "\n",
        "train_df[\"match\"] = train_df.apply(check, axis=1)\n",
        "vus_df[\"match\"] = vus_df.apply(check, axis=1)\n",
        "\n",
        "rate = train_df.groupby(\"GeneSymbol\")[\"match\"].mean().sort_values()\n",
        "print(\"Match rate overall (labeled):\", round(train_df[\"match\"].mean(), 3))\n",
        "print(\"\\nWorst 10 genes:\")\n",
        "print(rate.head(10))\n",
        "\n",
        "good_genes = rate[rate >= 0.95].index.tolist()\n",
        "bad_genes = rate[rate < 0.95].index.tolist()\n",
        "print(\"\\nGenes kept:\", len(good_genes))\n",
        "print(\"Genes removed (sequence mismatch):\", bad_genes)\n",
        "\n",
        "train_clean = train_df[train_df[\"GeneSymbol\"].isin(good_genes) & train_df[\"match\"]].drop(columns=\"match\")\n",
        "vus_clean = vus_df[vus_df[\"GeneSymbol\"].isin(good_genes) & vus_df[\"match\"]].drop(columns=\"match\")\n",
